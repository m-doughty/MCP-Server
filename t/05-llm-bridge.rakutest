use Test;
use lib 'lib';
use JSON::Fast;
use MCP::Server;

plan 12;

my $server = MCP::Server.new(:name<test>);

$server.tool: 'get_weather',
	description => 'Get weather for a location',
	params => {
		location => { type => 'string', description => 'City name', required => True },
	},
	handler => -> :%args { "Sunny, 22C in {%args<location>}" };

$server.tool: 'calculate',
	description => 'Evaluate a math expression',
	params => {
		expression => { type => 'string', description => 'Math expression', required => True },
	},
	handler => -> :%args { "42" };

# === tools-for-llm ===

subtest 'tools-for-llm returns OpenAI format' => {
	plan 4;
	my @tools = $server.tools-for-llm;
	is @tools.elems, 2, 'Two tools';
	is @tools[0]<type>, 'function', 'Type is function';
	ok @tools.first(*<function><name> eq 'get_weather').defined, 'get_weather present';
	ok @tools.first(*<function><name> eq 'calculate').defined, 'calculate present';
};

subtest 'tools-for-llm schema is correct' => {
	plan 3;
	my @tools = $server.tools-for-llm;
	my %weather = @tools.first(*<function><name> eq 'get_weather');
	is %weather<function><description>, 'Get weather for a location', 'Description';
	is %weather<function><parameters><properties><location><type>, 'string', 'Param type';
	ok %weather<function><parameters><required>.first(* eq 'location').defined, 'Required param';
};

subtest 'tools-for-llm is sorted by name, exactly as tools/list is' => {
	plan 3;

	# Registered out of alphabetical order on purpose: hash iteration order is not
	# stable in Raku, so an unsorted bridge would put a model's declarations in a
	# different order run to run -- and disagree with the catalogue a client built
	# on tools/list publishes.
	my $ordered = MCP::Server.new(:name<ordered>);
	for <zebra apple Mango banana> -> $name {
		$ordered.tool: $name, handler => -> :%args { $name };
	}

	my $names = $ordered.tools-for-llm.map({ $_<function><name> }).List;
	is-deeply $names, <Mango apple banana zebra>.List,
		'declarations come out sorted by name';

	my %listed = $ordered.handle-request({
		jsonrpc => '2.0', id => 1, method => 'tools/list',
	});
	is-deeply $names, %listed<result><tools>.map({ $_<name> }).List,
		'and in the same order tools/list sorts into';

	is-deeply $ordered.tools-for-llm.map({ $_<function><name> }).List, $names,
		'the order is stable between calls';
};

# === execute-tool-calls ===

subtest 'Execute single tool call' => {
	plan 2;
	my @calls = [{
		id => 'call_1',
		type => 'function',
		function => { name => 'get_weather', arguments => '{"location": "London"}' },
	},];
	my @results = $server.execute-tool-calls(@calls);
	is @results.elems, 1, 'One result';
	is @results[0]<content>, 'Sunny, 22C in London', 'Correct result';
};

subtest 'Execute returns tool message format' => {
	plan 2;
	my @calls = [{
		id => 'call_2',
		type => 'function',
		function => { name => 'calculate', arguments => '{"expression": "6*7"}' },
	},];
	my @results = $server.execute-tool-calls(@calls);
	is @results[0]<role>, 'tool', 'Role is tool';
	is @results[0]<tool_call_id>, 'call_2', 'Tool call ID preserved';
};

subtest 'Execute multiple tool calls' => {
	plan 2;
	my @calls = [
		{ id => 'c1', type => 'function', function => { name => 'get_weather', arguments => '{"location": "Paris"}' } },
		{ id => 'c2', type => 'function', function => { name => 'calculate', arguments => '{"expression": "1+1"}' } },
	];
	my @results = $server.execute-tool-calls(@calls);
	is @results.elems, 2, 'Two results';
	ok @results[0]<content>.contains('Paris'), 'First result correct';
};

subtest 'Execute unknown tool returns error' => {
	plan 2;
	my @calls = [{
		id => 'c3',
		type => 'function',
		function => { name => 'nonexistent', arguments => '{}' },
	},];
	my @results = $server.execute-tool-calls(@calls);
	ok @results[0]<content>.contains('Unknown tool'), 'Error for unknown tool';
	ok @results[0]<is_error>, 'Unknown tool is marked as error';
};

subtest 'Execute accepts associative arguments' => {
	plan 2;
	my @calls = [{
		id => 'c4',
		type => 'function',
		function => { name => 'get_weather', arguments => { location => 'Berlin' } },
	},];
	my @results = $server.execute-tool-calls(@calls);
	is @results[0]<content>, 'Sunny, 22C in Berlin', 'Associative arguments execute';
	nok @results[0]<is_error>, 'Associative arguments are not an error';
};

subtest 'Execute invalid arguments and handler failures return error messages' => {
	plan 4;

	$server.tool: 'fail',
		description => 'Always fail',
		params => {},
		handler => -> :%args { die 'boom' };

	my @calls = [
		{
			id => 'c5',
			type => 'function',
			function => { name => 'get_weather', arguments => '{"location":' },
		},
		{
			id => 'c6',
			type => 'function',
			function => { name => 'fail', arguments => '{}' },
		},
	];
	my @results = $server.execute-tool-calls(@calls);

	ok @results[0]<is_error>, 'Invalid JSON marked as error';
	ok @results[0]<content>.contains('Invalid tool arguments JSON'),
		'Invalid JSON error explains failure';
	ok @results[1]<is_error>, 'Handler exception marked as error';
	ok @results[1]<content>.contains('boom'), 'Handler exception message returned';
};

subtest 'Empty arguments mean no arguments, not a parse error' => {
	plan 8;

	# Models routinely send "" (and sometimes a blank line) as the arguments of a
	# tool that takes none.  Answering that with "Invalid tool arguments JSON"
	# tells the model its perfectly reasonable call was broken.
	$server.tool: 'nullary',
		description => 'Takes nothing',
		params => {},
		handler => -> :%args { "ran with {%args.elems} arguments" };

	my @calls = (
		{ id => 'e1', type => 'function', function => { name => 'nullary', arguments => '' } },
		{ id => 'e2', type => 'function', function => { name => 'nullary', arguments => "  \n\t " } },
		{ id => 'e3', type => 'function', function => { name => 'nullary' } },
		{ id => 'e4', type => 'function', function => { name => 'nullary', arguments => 'null' } },
	);
	my @results = $server.execute-tool-calls(@calls);

	nok @results[0]<is_error>, 'An empty arguments string is not an error';
	is @results[0]<content>, 'ran with 0 arguments', 'The tool ran with an empty argument hash';
	nok @results[1]<is_error>, 'Whitespace-only arguments are not an error either';
	is @results[1]<content>, 'ran with 0 arguments', 'And they too become an empty hash';
	nok @results[2]<is_error>, 'A missing arguments member was already fine and stays fine';
	is @results[2]<content>, 'ran with 0 arguments', 'It runs the same way';

	# Only *empty* is forgiven: a string that says something has to say a JSON
	# object, or the model needs to hear that it did not.
	ok @results[3]<is_error>, 'A non-empty string that is not an object is still an error';
	is @results[3]<content>, 'Tool arguments must be a JSON object', '...and says so';
};

subtest 'The tools run inside execute-tool-calls, not when the caller looks' => {
	plan 4;

	# A lazy `.map(...).list` would hand back a Seq whose handlers run at the
	# caller's first reification -- on another thread, after a cancellation, or
	# never.  Tools have side effects, so "when did it run?" is not a detail: an
	# agent that abandons a batch must not discover later that it deleted a file.
	my $ran = MCP::Server.new(:name<eager>);
	my $calls = 0;
	my $lock = Lock.new;
	$ran.tool: 'count', :handler(-> :%args { $lock.protect: { ++$calls }; 'counted' });

	my @results = $ran.execute-tool-calls([
		{ id => 'a', function => { name => 'count', arguments => {} } },
		{ id => 'b', function => { name => 'count', arguments => {} } },
	]);

	# Asserted before anything reads @results, which is the whole point.
	is $lock.protect({ $calls }), 2, 'Both handlers ran before the method returned';

	is @results.elems, 2, 'And the results were there waiting';
	is @results[1]<content>, 'counted', 'With the answers the handlers gave';
	is $lock.protect({ $calls }), 2, 'Reading them does not run anything a second time';
};

subtest 'structured tool results survive the local bridge without changing text' => {
	plan 4;
	my $structured = MCP::Server.new(:name<structured>);
	$structured.tool: 'inspect', handler => -> :%args {
		%(
			content => [%( type => 'text', text => 'visible' ),],
			structuredContent => %( revisionScheme => 'sha256-v1', value => 42 ),
		);
	};

	my @results = $structured.execute-tool-calls([{
		id => 'structured-1', function => { name => 'inspect', arguments => {} },
	},]);
	is @results[0]<content>, 'visible', 'the model-visible text is unchanged';
	is @results[0]<structured_content><revisionScheme>, 'sha256-v1',
		'the structured result is retained under the bridge key';
	is @results[0]<structured_content><value>, 42, 'structured values are not stringified';
	nok @results[0]<is_error>, 'a structured success remains a success';
};

done-testing;
