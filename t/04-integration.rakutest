use Test;
use lib 'lib';
use JSON::Fast;
use MCP::Server;

plan 5;

my $server = MCP::Server.new(:name<test-server>, :version<0.1.0>, :instructions('A test server'));

$server.tool: 'greet',
	description => 'Greet someone',
	params => { name => { type => 'string', description => 'Name to greet', required => True } },
	handler => -> :%args { "Hello, {%args<name>}!" };

$server.prompt: 'review',
	description => 'Code review prompt',
	arguments => [{ name => 'code', description => 'Code to review', required => True },],
	handler => -> :%args { "Please review this code:\n{%args<code>}" };

subtest 'Initialize handshake' => {
	plan 4;
	my %resp = $server.handle-request({
		jsonrpc => '2.0', id => 1, method => 'initialize',
		params => {
			protocolVersion => '2025-11-25',
			capabilities => {},
			clientInfo => { name => 'test-client', version => '1.0' },
		},
	});
	is %resp<result><protocolVersion>, '2025-11-25', 'Protocol version';
	is %resp<result><serverInfo><name>, 'test-server', 'Server name';
	is %resp<result><serverInfo><version>, '0.1.0', 'Server version';
	ok %resp<result><capabilities><tools>:exists, 'Tools capability declared';
};

subtest 'Ping' => {
	plan 1;
	my %resp = $server.handle-request({
		jsonrpc => '2.0', id => 2, method => 'ping',
	});
	ok %resp<result>.defined, 'Ping returns result';
};

subtest 'Unknown method' => {
	plan 2;
	my %resp = $server.handle-request({
		jsonrpc => '2.0', id => 3, method => 'nonexistent/method',
	});
	ok %resp<error>:exists, 'Error for unknown method';
	is %resp<error><code>, -32601, 'Method not found code';
};

subtest 'Full tool call flow' => {
	plan 1;
	my %resp = $server.handle-request({
		jsonrpc => '2.0', id => 4, method => 'tools/call',
		params => { name => 'greet', arguments => { name => 'World' } },
	});
	is %resp<result><content>[0]<text>, 'Hello, World!', 'Tool call produces correct output';
};

subtest 'Prompt get' => {
	plan 1;
	my %resp = $server.handle-request({
		jsonrpc => '2.0', id => 5, method => 'prompts/get',
		params => { name => 'review', arguments => { code => 'fn main() {}' } },
	});
	ok %resp<result><messages>[0]<content><text>.contains('fn main'), 'Prompt includes code';
};

done-testing;
